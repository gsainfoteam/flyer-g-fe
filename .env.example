# 실제 API base URL. HTTPS만 허용하며 localhost만 예외다.
# mock 모드에서는 비워 둘 수 있다.
VITE_API_BASE_URL=

# 데모 배포 여부. 백엔드 없이 mock을 그대로 배포해 보여줄 때 쓴다.
# 지금은 비워 두면 true다(실제 API가 아직 없어 데모가 유일한 배포 형태라서).
# 실제 API를 연결하면 false로 두거나 기본값을 false로 바꾼다.
# 데모 배포 화면에는 "데모 화면이에요" 안내 띠가 붙는다.
VITE_DEMO_MODE=

# in-memory mock repository 사용 여부.
# 비워 두면 개발 빌드와 데모 배포는 true, 그 밖의 production 빌드는 false다.
# 데모가 아닌 production 빌드에서 true로 두면 앱이 시작 시점에 실패한다.
VITE_USE_MOCK_API=

# mock 세션 사용 여부.
# true면 로그인 버튼 한 번으로 세션이 생기고, 계정 메뉴에 역할 전환이 나타난다.
# 저장하는 값은 토큰이 아니라 역할 이름이며 sessionStorage에만 둔다.
# 기본값과 production 규칙은 VITE_USE_MOCK_API와 같다.
VITE_USE_MOCK_AUTH=
