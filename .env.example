# 실제 API base URL. HTTPS만 허용하며 localhost만 예외다.
# mock 모드에서는 비워 둘 수 있다.
VITE_API_BASE_URL=

# 로그인 (account.gistory.me OAuth/OIDC, PKCE).
# 프론트가 https://account.gistory.me/authorize로 보낼 때 쓰는 값이다.
# client_id는 공개 값이다. client secret은 프론트에 두지 않는다.
# redirect_uri는 IdP에 등록한 주소와 정확히 같아야 한다. 백엔드 POST /auth/login에도
# 같은 값을 보낸다. 예: http://localhost:5173/auth/callback
# mock 세션(VITE_USE_MOCK_AUTH=true)에서는 비워 둘 수 있다.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=

# 데모 배포 여부. 백엔드 없이 mock을 그대로 배포해 보여줄 때만 true로 둔다.
# 비워 두면 false다. 데모 배포 화면에는 "데모 화면이에요" 안내 띠가 붙는다.
VITE_DEMO_MODE=

# in-memory mock repository 사용 여부. 아래 단위별 값이 없을 때의 기본값이다.
# 비워 두면 개발 빌드와 데모 배포는 true, 그 밖의 production 빌드는 false다.
# 데모가 아닌 production 빌드에서 mock 단위가 하나라도 있으면 앱이 시작 시점에 실패한다.
VITE_USE_MOCK_API=

# 단위별 연동 (Phase 08). mock 또는 real. 비워 두면 VITE_USE_MOCK_API를 따른다.
# display(TV 편성·상태 보고)를 뺀 단위를 real로 두려면 실제 로그인(VITE_USE_MOCK_AUTH=false)이
# 필요하다. production 빌드는 모든 단위가 real이어야 한다(데모 제외).
VITE_API_MODE_UPLOAD=
VITE_API_MODE_SUBMISSIONS=
VITE_API_MODE_REVIEWS=
VITE_API_MODE_REFERENCE=
VITE_API_MODE_DEVICES=
VITE_API_MODE_DISPLAY=

# mock 세션 사용 여부.
# true면 로그인 버튼 한 번으로 세션이 생기고, 계정 메뉴에 역할 전환이 나타난다.
# 저장하는 값은 토큰이 아니라 역할 이름이며 sessionStorage에만 둔다.
# 기본값과 production 규칙은 VITE_USE_MOCK_API와 같다.
VITE_USE_MOCK_AUTH=

# 백엔드 Swagger 문서로 계약 타입을 만들 때 쓴다 (`bun run api:sync`). 앱 번들에는 들어가지 않는다.
# OPENAPI_URL을 비우면 ${VITE_API_BASE_URL}/docs-json에서 받는다.
# OPENAPI_BASIC_AUTH는 Swagger 보호용 "아이디:비밀번호"다.
OPENAPI_URL=
OPENAPI_BASIC_AUTH=
