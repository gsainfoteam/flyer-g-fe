# 실제 API base URL. HTTPS만 허용하며 localhost만 예외다.
# mock 모드에서는 비워 둘 수 있다.
VITE_API_BASE_URL=

# 개발용 in-memory mock repository 사용 여부.
# 비워 두면 개발 빌드는 true, production 빌드는 false가 기본값이다.
# production 빌드에서 true로 두면 앱이 시작 시점에 실패한다.
VITE_USE_MOCK_API=

# 개발용 mock 세션 사용 여부.
# true면 로그인 버튼 한 번으로 세션이 생기고, 상단에 역할 전환이 나타난다.
# 저장하는 값은 토큰이 아니라 역할 이름이며 sessionStorage에만 둔다.
# production 빌드에서 true로 두면 앱이 시작 시점에 실패한다.
VITE_USE_MOCK_AUTH=
